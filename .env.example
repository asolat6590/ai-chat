# --- Backend (Gemini) ---
# Ключ только из Google AI Studio (начинается с AIzaSy...)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
PORT=3000
SELLER_PHONE=+7 (800) 555-12-34
# Для новых ключей Google: gemini-3.5-flash-lite, gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# Если ключа AIza ещё нет — демо-ответы на backend (true по умолчанию)
GEMINI_FALLBACK_MOCKS=true

# --- Frontend ---
# Локально: прокси Vite (npm run dev)
VITE_API_URL=/api
VITE_USE_MOCKS=false

# Vercel: задайте те же VITE_* в Project → Settings → Environment Variables
# и GEMINI_API_KEY / GEMINI_MODEL / SELLER_PHONE для serverless API (/api/*)

# Вариант B: напрямую на сервер
# VITE_API_URL=http://localhost:3000
# VITE_USE_MOCKS=false

# Только моки без Gemini (если API URL не задан или true)
# VITE_USE_MOCKS=true
